# Hosted free LLM. No model download and no OpenAI API billing required.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace_with_your_free_openrouter_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:8501
APP_NAME=LLM Translational Biomarker Assistant
REQUEST_TIMEOUT_SECONDS=120
MAX_GENERATION_ATTEMPTS=3

# Embeddings remain local so document indexing has no API charge.
EMBEDDING_BACKEND=local
CHROMA_PATH=.chroma
COLLECTION_NAME=translational_evidence

# Used by the PubMed collector.
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=
